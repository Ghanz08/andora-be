APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Google SSO is configured in Supabase Auth Dashboard, not in this backend.
# React Native obtains a Supabase access token after Google sign-in and sends it as:
# Authorization: Bearer <supabase_access_token>

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=id
LIVEKIT_STT_KEYTERMS=beasiswa,Beasiswa Kaltim Tuntas,Kaltim Tuntas,Beasiswa Unggulan
LIVEKIT_TTS_MODEL=cartesia/sonic-3
LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

NINEROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=ghn-fast
NINEROUTER_MAX_TOKENS=2048

GOOGLE_API_KEY=
GEMINI_REALTIME_MODEL=gemini-3.8-live
GEMINI_REALTIME_VOICE=Puck
GEMINI_REALTIME_TEMPERATURE=0.8
